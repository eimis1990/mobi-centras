# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# The one shared shop password staff sign in with.
APP_PASSWORD=change-me

# Random string, 32+ characters. Signs the session cookie and encrypts the stored Twilio credentials.
# Changing it signs everyone out and makes stored Twilio credentials unreadable (re-enter them in Settings).
SECRET_KEY=change-me-to-something-long-and-random

# Set automatically by Vercel when a Blob store is attached to the project. Leave unset in dev to use .data/ files.
# BLOB_READ_WRITE_TOKEN=
